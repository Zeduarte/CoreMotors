# ============================================================================
# CoreMotors — variáveis de ambiente
# Copie para `.env.local` e preencha com os valores do seu projeto Supabase.
# (Nunca faça commit do `.env.local` — está no .gitignore.)
# ============================================================================

# URL do projeto Supabase.
# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chave anónima (pública). Segura para o browser — a segurança é imposta por RLS.
# Supabase → Project Settings → API Keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave service_role (SECRETA). Necessária para submissões públicas, utilizadores e manutenção.
# NUNCA a exponha no browser nem lhe ponha o prefixo NEXT_PUBLIC_.
# Supabase → Project Settings → API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# URL público canónico do site (usado em metadata, sitemap e Open Graph).
NEXT_PUBLIC_SITE_URL=https://engineline.pt

# Segredo aleatório longo que protege /api/maintenance e a função agendada Netlify.
MAINTENANCE_SECRET=
# Segredo opcional para hashes dos limites; por defeito usa a service_role.
SUBMISSION_HASH_SECRET=
# Header de IP APENAS se o proxy do alojamento o substituir sempre.
# Netlify: x-nf-client-connection-ip. Deixar vazio se não tiver essa garantia.
# RECOMENDADO em produção: sem ele não há limite por IP nas submissões públicas
# (só o global e o por identidade) e o servidor regista um aviso nos logs.
TRUSTED_CLIENT_IP_HEADER=
# Chave da API da Anthropic (SECRETA), usada pelo assistente virtual em /api/chat.
# console.anthropic.com → API Keys. Defina também um limite de gasto mensal.
# NUNCA lhe ponha o prefixo NEXT_PUBLIC_. Se ficar vazia, o chat não aparece.
# Também é usada pelas ordens por WhatsApp.
ANTHROPIC_API_KEY=

# Ordens do backoffice por WhatsApp (WhatsApp Cloud API da Meta). Todas
# SECRETAS e só no servidor. Sem elas o canal fica desligado, mas o simulador
# em Integrações continua a funcionar (só precisa da ANTHROPIC_API_KEY).
# Token que você inventa e escreve igual no painel da Meta, ao configurar o URL.
WHATSAPP_VERIFY_TOKEN=
# Segredo da app da Meta (Definições da app → Básico). Valida que cada pedido
# vem mesmo da Meta — sem ele, todas as mensagens são recusadas.
WHATSAPP_APP_SECRET=
# Botão «Ligar número do WhatsApp» em Integrações (Embedded Signup da Meta).
# Com estas duas, o número liga-se no backoffice e as duas seguintes deixam de
# ser precisas. Não são secretas (vão para o browser), mas sem o App Secret e o
# Verify Token acima o botão não aparece. A app da Meta é a do fornecedor: as
# quatro variáveis da app são iguais em todos os sites clientes.
# ID da app da Meta (Definições da app → Básico → ID da app).
WHATSAPP_APP_ID=
# ID da configuração do Facebook Login for Business com o Embedded Signup do
# WhatsApp (Facebook Login for Business → Configurações).
WHATSAPP_CONFIG_ID=
# Alternativa ao botão: o número fixo nas variáveis. Só é usado quando não há
# nenhum número ligado no backoffice.
# Identificador do número de telefone de empresa (não é o número em si).
WHATSAPP_PHONE_NUMBER_ID=
# Token de acesso permanente de um utilizador do sistema, para enviar respostas.
WHATSAPP_ACCESS_TOKEN=
# Versão do Graph API. É a que aparece no exemplo de envio do painel da app
# (Step 1. Try it out). A Meta descontinua versões antigas; se as respostas
# deixarem de sair, compare com a que o painel mostra.
WHATSAPP_GRAPH_VERSION=v25.0

# Lista exata de hosts HTTPS permitidos para notificações (opcional).
NOTIFICATION_WEBHOOK_HOSTS=hooks.slack.com,discord.com,discordapp.com,hook.eu1.make.com,hook.us1.make.com,hooks.zapier.com

# Google Places API (New): apenas servidor; opcional, requer faturação/quota Google.
GOOGLE_PLACES_API_KEY=

# Publicação automática no OLX (OLX Partner API). SECRETAS, só no Netlify.
# O OLX envia estes dois valores por email quando aprova o acesso à API.
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=
# Opcional e normalmente vazio: o OLX usa o Callback URL registado na
# aplicação. Só se define se houver vários registados — e então tem de ser
# exatamente um deles. Enviá-lo sem necessidade faz a firewall do OLX recusar.
# O Callback URL registado no portal OLX Partner tem de ser
# https://<domínio>/api/olx/callback — com http://localhost registado, o OLX
# devolve o utilizador a localhost (ERR_CONNECTION_REFUSED).
OLX_REDIRECT_URI=

# ID da conta do WhatsApp Business (WABA). Só é preciso se o número estiver nestas variáveis
# e não ligado em Integrações: é com ele que o botão «Criar os modelos na Meta» funciona.
WHATSAPP_BUSINESS_ACCOUNT_ID=
